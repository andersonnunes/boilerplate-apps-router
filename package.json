{
  "name": "boilerplate-apps-router",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "test": "jest --passWithNoTests --maxWorkers=50%",
    "test:watch": "jest --watch --maxWorkers=25%",
    "test:ci": "jest --runInBand",
    "generate": "bunx plop --plopfile generators/plopfile.js",
    "start": "next start",
    "lint": "eslint",
    "prepare": "husky install",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "next": "16.4.5",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10",
    "@storybook/addon-links": "^10.6.5",
    "@storybook/addon-onboarding": "^10.6.5",
    "@storybook/nextjs": "^10.6.5",
    "@storybook/react": "^10.6.5",
    "@storybook/testing-library": "^0.2.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/jest": "^30.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^10.14.0",
    "eslint-config-next": "16.4.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-storybook": "^10.6.5",
    "husky": "^8.0.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "jest-styled-components": "^7.4.1",
    "lint-staged": "^17.6.0",
    "plop": "^4.0.5",
    "prettier": "^3.9.10",
    "storybook": "^10.6.5",
    "styled-components": "^6.6.0",
    "typescript": "^5"
  },
  "packageManager": "bun@1.4.4",
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
